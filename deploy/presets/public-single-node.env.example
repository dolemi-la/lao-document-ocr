# Example hardened single-node deployment behind a reverse proxy.
# Replace the example domains before use.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=5173

VITE_API_URL=https://api.ocr.example.com
CORS_ORIGINS=https://ocr.example.com

MAX_UPLOAD_BYTES=26214400
MAX_PAGES=60
MAX_PAGE_PIXELS=40000000

JOB_MAX_WORKERS=2
JOB_MAX_ACTIVE=8
JOB_RETENTION_SECONDS=3600
BATCH_MAX_FILES=10

RESULT_STORAGE_BACKEND=filesystem
RESULT_STORAGE_ROOT=/data/results

RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CLIENTS=10000
RATE_LIMIT_TRUST_PROXY_HEADERS=true
