# NVIDIA GPU owned-recognizer preset.
# Use with deploy/compose.gpu.yml.
OCR_DEVICE=cuda
OCR_MODEL_DIR=./models
OCR_CALIBRATION_PATH=

# Leave empty to install PyTorch from PyPI.
# For a specific CUDA wheel, set the official PyTorch index URL that matches
# your deployment/driver requirements.
TORCH_INDEX_URL=

GPU_JOB_MAX_WORKERS=1
GPU_JOB_MAX_ACTIVE=4

# Optional S3 result storage can be combined with deploy/compose.s3.yml.
INSTALL_S3=false
